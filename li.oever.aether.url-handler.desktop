[Desktop Entry]
Name=Aether URL Handler
Comment=Ask user for confirmation before applying themes, colors, and wallpapers from aether:// web links
Exec=/usr/share/ohmydebn/bin/ohmydebn-aether-url-guard %u
Icon=aether
Terminal=false
Type=Application
NoDisplay=true
MimeType=x-scheme-handler/aether;
Categories=Utility;
Keywords=theme;color;wallpaper;import;
StartupNotify=false
